# Lớp 1 — model NER chạy local (kiendt/phobert-ner-address)
# Không cần API key. Model tải về ./models/ bằng BUILD_LAYER1_MODEL.md.
# HF_HOME đặt tường minh để cache không rơi vào ổ hệ thống.
HF_HOME=.hf-cache

# Nhánh thử nghiệm song song — LLM parse trực tiếp qua OpenRouter
# (scripts/external_api/qwen/run_qwen_on_file.py). Xem results/README.md mục 4 về chi phí.
OPENROUTER_API=
OPENROUTER_MODEL=qwen/qwen3.6-35b-a3b

# Lớp 2 — DeepSeek (comparator, chấm điểm parse cũ vs mới)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# Tuỳ chọn cho scripts/external_api/deepseek/run_deepseek_on_file.py.
# API DeepSeek không trả chi phí; đặt giá "vào_miss,vào_hit,ra" (USD/1M token) để script tự tính.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_PRICE_PER_1M=

# Lớp 3 — OpenAI (arbiter, chốt quyết định)
OPENAI_API_KEY=
OPENAI_MODEL=
